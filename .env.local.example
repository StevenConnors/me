NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
MONGODB_URI=your_mongodb_connection_string

# Server-only Vercel Web Analytics API access for the protected admin dashboard.
VERCEL_ANALYTICS_TOKEN=your_vercel_access_token
VERCEL_ANALYTICS_PROJECT_ID=your_vercel_project_id
# Set this when the Vercel project belongs to a team.
VERCEL_ANALYTICS_TEAM_ID=your_vercel_team_id

# Private editor authentication. Keep every value except the cloud name server-only.
AUTH_SECRET=generate_a_long_random_secret
AUTH_GITHUB_ID=your_github_oauth_client_id
AUTH_GITHUB_SECRET=your_github_oauth_client_secret
ADMIN_GITHUB_ID=your_immutable_github_numeric_user_id

# Cloudinary server credentials used only for signed uploads and asset inspection.
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_EDITOR_UPLOAD_FOLDER=journey-editor
# Maximum video upload size in bytes. Defaults to 250 MiB when unset.
CLOUDINARY_EDITOR_MAX_VIDEO_BYTES=262144000
