#!/usr/bin/env python3
"""Stand-in for macOS sips: reports the size the fake exporter recorded and logs conversions."""

import json
import os
import shutil
import sys

args = sys.argv[1:]
if args[0] == "-g":
    width, height = json.load(open(f"{args[-1]}.size"))
    print(f"{args[-1]}\n  pixelWidth: {width}\n  pixelHeight: {height}")
    sys.exit(0)
source, target = args[-3], args[-1]
with open(os.environ["FAKE_SIPS_LOG"], "a") as log:
    log.write(json.dumps({"source": os.path.basename(source), "args": args[:-3]}) + "\n")
shutil.copyfile(source, target)
